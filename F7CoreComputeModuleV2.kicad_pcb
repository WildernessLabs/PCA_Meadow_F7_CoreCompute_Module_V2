    (effects (font (size 1.5 1.5) (thickness 0.3)))
  )
  (gr_text "Engineer: Sheldon Johnson\n" (at 165.48196 132.33592) (layer Dwgs.User) (tstamp 5FF7FFA6)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (gr_text "Wilderness Labs " (at 161.41796 134.36792) (layer Dwgs.User) (tstamp 5FF7FFA9)
    (effects (font (size 1 1) (thickness 0.15)))
