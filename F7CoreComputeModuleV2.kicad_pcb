  (gr_text "F7 Embed Rev" (at 181.3 135.1 90) (layer "F.SilkS") (tstamp 00000000-0000-0000-0000-00006106c607)
    (effects (font (size 0.508 0.508) (thickness 0.127)))
  )
  (gr_text "PCB FAB NOTES:\n" (at 225.6 19.6) (layer "Dwgs.User") (tstamp 00000000-0000-0000-0000-00005fb1fe85)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "LAYER" (at 168.387 103.9444) (layer "Dwgs.User") (tstamp 00000000-0000-0000-0000-00005fb3b791)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (gr_text "14" (at 191.1 142.85) (layer "Dwgs.User") (tstamp 00000000-0000-0000-0000-00005fe0df94)
    (effects (font (size 0.6 0.6) (thickness 0.09)))
  )
  (gr_text "14.   ONLY PLACE BREAKAWAY TABS IN THE MARKED LOCATIONS" (at 224.8 136.55) (layer "Dwgs.User") (tstamp 00000000-0000-0000-0000-00005fe0dfcb)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "14" (at 214.57 106.205) (layer "Dwgs.User") (tstamp 00000000-0000-0000-0000-00006111a2c9)
    (effects (font (size 0.6 0.6) (thickness 0.09)))
  )
  (gr_text "14" (at 182.85 104.98) (layer "Dwgs.User") (tstamp 00000000-0000-0000-0000-00006111a300)
    (effects (font (size 0.6 0.6) (thickness 0.09)))
  )
  (gr_text "x 90\n" (at 216.08 120.64) (layer "Dwgs.User") (tstamp 020b7e1f-8bb0-4882-91d4-7894bf18db84)
    (effects (font (size 0.7 0.7) (thickness 0.1)))
  )
  (gr_text "10. NON-DESTRUCTIVE EVALUATION:\nA. ALL PWBS SHALL PASS 100% ELECTRICAL TEST USING SUPPLIED IPC-356 NETLIST IN ACCORDANCE WITH CURRENT REVISION OF IPC-9252, CLASS 2.\nB. CERTIFICATE OF CONFORMANCE SHALL BE SUPPLIED WITH EACH SHIPMENT." (at 225.3 112.9) (layer "Dwgs.User") (tstamp 058e77a4-10af-4bc8-a984-5984d3bbee4c)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "Wilderness Labs " (at 167.8762 120.229) (layer "Dwgs.User") (tstamp 09ab0b5c-3dee-42c8-b9e5-de0673874ccd)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (gr_text "4. ETCH GEOMETRY:\nA. MEASURE WIDTH FROM THE BASE OF THE METALLIZATION.\nB. MINIMUM LINE WIDHT: 0.11 MM OUTER, 0.11 MM INNER LAYERS.\nC. FINISHED LINE WIDTH AND TERMINAL AREA SHALL NOT DEVIATE FROM THE 1-TO-1 MASTER PATTERN IMAGE BY MORE THAN +/- 0.025 MM OR 20%, WHICHEVER IS LESS." (at 225.2 53.7) (layer "Dwgs.User") (tstamp 0bbd2e43-3eb0-4216-861b-a58366dbe43d)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "12. IMPEDANCE (ALL TOLERANCES +/- 10%)\nA. REFER TO SUPPLIED STACK UP FOR TRACE WIDTHS.\nB. VENDOR MAY ADJUST DESIGN GEOMETRIES UP TO +/-20% TO ACHIEVE TARGET IMPEDANCE. ADJUSTMENTS BEYOND 20% OF LINE WIDTH, SPACING OR DIELECTRIC THICKNESS SHALL REQUIRE APPROVAL FROM WILDERNESS LABS ENGINEERING." (at 225.1 125.7) (layer "Dwgs.User") (tstamp 18e95a1d-9d1d-4b93-8e4c-2d03c344acc0)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "3. FLATNESS:\nA. BOW AND TWIST OF ASSEMBLY SUB-PANEL OR SINGULATED PWB SHALL NOT EXCEED .025 MM PER MM.\nB. TEST IN ACCORDANCE WITH THE CURRENT REVISION OF IPC-TM-650 2.4.22" (at 225.2 46.5) (layer "Dwgs.User") (tstamp 1eca5f72-2356-4c55-919d-595727faf3b9)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "13" (at 213.58 120.74) (layer "Dwgs.User") (tstamp 29ec1a54-dea0-4d1a-a3dc-a7441a09bb9e)
    (effects (font (size 0.6 0.6) (thickness 0.09)))
  )
  (gr_text "Engineer: Sheldon Johnson\n" (at 164.0154 122.261) (layer "Dwgs.User") (tstamp 35431843-170f-401f-88d7-da91172bed86)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (gr_text "5. SURFACE FINISH: ENIG\nA. ENEPIG PLATING IN ACCORDANCE WITH CURRENT REVISION OF IPC4556. EXPOSED METAL SHALL HAVE 118–236 MICRO INCHES ELECTROLESS NICKEL, 2–6 MICRO INCHES ELECTROLESS PALLADIUM, AND 1.2MICRO INCHES GOLD.\nB. ENIG PLATING PER CURRENT REVISION OF IPC-4552. EXPOSED METAL SHALL HAVE 118–236 MICRO INCHES ELECTROLESS NICKEL AND 2–5 MICRO INCHES GOLD." (at 225.2 61.4) (layer "Dwgs.User") (tstamp 44e993be-f2df-4e61-a598-dfd6e106a208)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "7. HOLES:\nA. ALL 0.2MM HOLES TO BE FILLED AND COPPER TENTED\nB. MINIMUM FINISHED HOLE SIZE: 0.2 MM\nC. HOLE SIZE MEASURED AFTER PLATING.\nD. SEE DRILL CHART FOR FINISHED HOLE SIZE AND TOLERANCE.\nE. ALL HOLES SHALL BE LOCATED WITHIN 0.08 MM OF TRUE POSITION AS SUPPLIED IN CAD DATA.\nF. PLATING IN HOLES SHALL BE CONTINUOUS ELECTROLYTIC COPPER WITH 0.025 MM MINIMUM BARREL THICKNESS." (at 225.2 79.9) (layer "Dwgs.User") (tstamp 45b7fe01-a2fa-40c2-a3a2-4a9ae7c34dba)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "8. SOLDERMASK:\nA. SOLDERMASK OVER BARE COPPER (SMOBC) ON PRIMARY AND SECONDARY SIDES USING SUPPLIED ARTWORK IN ACCORDANCE WITH CURRENT REVISION OF IPC-SM-840 TYPE B.\nB. COLOR: MATTE BLACK\nC. LIQUID PHOTO-IMAGEABLE (LPI) 0.001 MM TO 0.002 MM THICKNESS, HALOGEN FREE\nD. NO BLEED-OUT ALLOWED OVER EXPOSED SMD PADS.\nE. NO EXPOSED TRACES." (at 225.2 91.6) (layer "Dwgs.User") (tstamp 4c4b4317-29d0-438a-b331-525ede18773a)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "1. STANDARDS:\nA. FABRICATE PCB IN ACCORDANCE WITH THE CURRENT REVISION OF IPC-6012, CLASS 2.\nB. INTERPRET DIMENSIONS AND TOLERANCES IN ACCORDANCE WITH THE CURRENT REVISION OF ASME Y14.5M.\nC. DO NOT SCALE DRAWING." (at 225.1 28.9) (layer "Dwgs.User") (tstamp 55fa5fa0-9426-4801-b40c-682e71189d8a)
    (effects (font (size 1 1) (thickness 0.2)) (justify left))
  )
  (gr_text "2. MATERIAL:\nA. FR4 Tg 180 C OR EQUIVALENT.\nB. EQUIVALENT MATERIAL SHALL BE RoHS COMPLIANT, HALOGEN FREE AND APPROVED BY WILDERNESSLABS\nC. THICKNESS OF INDIVIDUAL COPPER CLAD SHEETS SHALL BE IN AS\nDEFINED IN STACK-UP. SEE DETAIL A." (at 225.1 38.4) (layer "Dwgs.User") (tstamp 5dffd1d6-faf9-418e-b9a0-84fb6b6b4454)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "6. DESTRUCTIVE TESTING:\nA. MICRO SECTION SAMPLE AND REPORT SHALL BE PROVIDED TO WILDERNESS LABS DESIGN ENGINEERING.\nB. SOLDER SAMPLE PROCESSED THROUGH LEAD-FREE SOLDERING SHALL BE INCLUDED WITH EACH SHIPMENT.\nC. X-OUT PANELS MAY BE USED FOR SOLDER SAMPLE." (at 225.1 68.6) (layer "Dwgs.User") (tstamp 6239967a-77bd-4ec9-89cd-e04efd8dbe26)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "Part: F7 CCM V2A\n\n" (at 167.78 124.98) (layer "Dwgs.User") (tstamp 6fddc16f-ccc1-4ade-884c-d6efda461da8)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (gr_text "9. SILKSCREEN:\nA. SILKSCREEN PRIMARY SIDE WITH WHITE EPOXY, NON-CONDUCTIVE, NON-NUTRIENT INK.\nB. ANY UNSPECIFIED STROKE WIDTH SHALL BE 0.1 MM\nC. CLIP SILKSCREEN AWAY FROM ANY EXPOSED METAL.\nD. VENDOR DATE CODE, LOGO, UL AND ANY ADDITIONAL MARKING TO BE LOCATED ON THE SECONDARY SIDE.\nE. BAG AND TAG ACCEPTABLE FOR PWBS THAT ARE TOO SMALL FOR MARKING." (at 225.3 103) (layer "Dwgs.User") (tstamp 83d9db3e-661a-47bf-b26c-99313ad8bac9)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "11. PACKAGING REQUIREMENTS:\nA. PWBS SHALL BE PACKAGED IN VACUUM SEALED INNER CONTAINERS AS A PANEL.\nB. OUTER CONTAINERS SHALL BE SUFFICIENT TO PREVENT DAMAGE DURING SHIPPING AND HANDLING." (at 225.2 119.4) (layer "Dwgs.User") (tstamp 9bac5a37-2a55-41dd-96ea-ec02b69e3ef4)
    (effects (font (size 1 1) (thickness 0.15)) (justify left))
  )
  (gr_text "TOTAL THICKNESS 63.25MM" (at 96.4 264.5) (layer "Dwgs.User") (tstamp d1422f38-9fce-4f5e-878a-341530beaf9c)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (gr_text "14" (at 207.6 142.85) (layer "Dwgs.User") (tstamp d87cc3e6-70e4-41ba-bfa9-1612995ab3dd)
